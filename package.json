{
  "name": "gr-acrobat",
  "version": "3.1.2",
  "description": "GR Acrobat：离线 PDF 软件，查看 / 拆分 / 合并整理 / 转图片 / 图片转 PDF / 打印",
  "main": "main.js",
  "author": "龙禹良",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "python3 tests/run.py",
    "test:windows": "python tests/windows/test_components.py",
    "fixtures": "python3 tests/make_fixtures.py",
    "pack:win": "electron-builder --win dir --x64 --ia32",
    "dist": "npm run pack:win && node build/make-installer.js"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "resedit": "^1.7.2"
  },
  "build": {
    "appId": "com.lylsecem.gracrobat",
    "productName": "GR Acrobat",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "i18n.js",
      "icon.ico",
      "vendor/**"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "copyright": "© 2026 龙禹良制作",
    "afterPack": "./build/afterPack.js"
  }
}
